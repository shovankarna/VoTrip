# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit real values.
# Both docker compose and the Spring Boot app read from it.

# --- Local Postgres (consumed by docker-compose.yml) ---
POSTGRES_DB=votrip
POSTGRES_USER=votrip
POSTGRES_PASSWORD=votrip
POSTGRES_PORT=5432

# --- Spring Boot datasource (must match the Postgres values above) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/votrip
DATABASE_USERNAME=votrip
DATABASE_PASSWORD=votrip

# --- Firebase Admin SDK ---
# REQUIRED. Absolute path to the service account JSON downloaded from
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the file OUTSIDE the repo, or at least outside version control.
FIREBASE_CREDENTIALS_PATH=/path/xyz.json

# OPTIONAL. Only needed to override the project baked into the service account file.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# --- App ---
SERVER_PORT=8080
